{
  "name": "gogly",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/hark": "^1.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "electron-updater": "^6.6.2",
    "firebase": "^12.6.0",
    "hark": "^1.2.3",
    "katex": "^0.16.25",
    "pdfjs-dist": "^5.4.449",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.gogly.app",
    "productName": "gogly",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "yeshaswi3060",
      "repo": "interview-cheater"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "executableName": "RuntimeBroker",
      "requestedExecutionLevel": "requireAdministrator",
      "sign": "./scripts/sign.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "gogly"
    }
  }
}